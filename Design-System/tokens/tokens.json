{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Longbridge US 设计语言 · Design Tokens (W3C DTCG SSOT)",
  "$source": "颜色:Design-System/颜色·资源库 Colors.pdf;其他维度:stock-detail-v2 Bloomberg 风格归纳(待 Figma 字体/间距/圆角 frame 定稿后回填)",
  "$updated": "2026-05-15",
  "$theme": "dark",
  "$note": "Single Source of Truth — 手动维护此文件,然后跑 node scripts/build-tokens.mjs 生成 tokens.css 和 tokens.ts。此文件本身就是 W3C DTCG 标准,设计工具(Figma/Tokens Studio)可直接读写。",

  "color": {
    "$description": "颜色(深色版)— 1:1 对齐 Figma 颜色·资源库",
    "bg-1":            { "$type": "color", "$value": "#0a0e19",                 "$description": "一级背景色" },
    "bg-2":            { "$type": "color", "$value": "#232630",                 "$description": "二级背景色" },
    "card":            { "$type": "color", "$value": "#232630",                 "$description": "卡片填充色" },
    "card-2":          { "$type": "color", "$value": "#181b26",                 "$description": "卡片上的二级色" },
    "soft":            { "$type": "color", "$value": "#1a1e28",                 "$description": "列表斑马线" },
    "tab-active":      { "$type": "color", "$value": "#ffffff",                 "$description": "tab 选中色" },
    "line":            { "$type": "color", "$value": "#3b3e47",                 "$description": "分隔线(强)" },
    "stroke":          { "$type": "color", "$value": "#2c3039",                 "$description": "卡片描边" },
    "line-button":     { "$type": "color", "$value": "#363a47",                 "$description": "辅助按钮描边" },

    "fg-1":            { "$type": "color", "$value": "#ffffff",                 "$description": "一级字体" },
    "fg-2":            { "$type": "color", "$value": "#9d9fa3",                 "$description": "二级字体" },
    "fg-3":            { "$type": "color", "$value": "#60626a",                 "$description": "三级字体" },
    "fg-4":            { "$type": "color", "$value": "#363a47",                 "$description": "辅助/最弱" },
    "fg-inverse":      { "$type": "color", "$value": "#0a0e19",                 "$description": "反白文字" },

    "brand-1":         { "$type": "color", "$value": "#00f0c4",                 "$description": "品牌色(长桥青)" },
    "brand-2":         { "$type": "color", "$value": "#09252a",                 "$description": "品牌辅助色" },
    "brand-3":         { "$type": "color", "$value": "#203a3f",                 "$description": "卡片品牌辅助" },
    "brand-soft":      { "$type": "color", "$value": "rgba(0, 240, 196, 0.1)",  "$description": "品牌色 10% 透明" },
    "brand-glow":      { "$type": "color", "$value": "rgba(0, 240, 196, 0.22)", "$description": "品牌色辉光" },
    "accent":          { "$type": "color", "$value": "{color.brand-1}",         "$description": "brand-1 别名(强调/ticker)" },
    "accent-soft":     { "$type": "color", "$value": "{color.brand-soft}",      "$description": "brand-soft 别名" },
    "accent-glow":     { "$type": "color", "$value": "{color.brand-glow}",      "$description": "brand-glow 别名" },

    "up":              { "$type": "color", "$value": "#00ada2",                 "$description": "上涨色(青绿)" },
    "up-soft":         { "$type": "color", "$value": "rgba(0, 173, 162, 0.14)" },
    "down":            { "$type": "color", "$value": "#ff3a75",                 "$description": "下跌色(粉红)" },
    "down-soft":       { "$type": "color", "$value": "rgba(255, 58, 117, 0.14)" },
    "flat":            { "$type": "color", "$value": "#60626a",                 "$description": "平盘/灰" },

    "error":           { "$type": "color", "$value": "#f7415f",                 "$description": "错误/警告" },
    "warn":            { "$type": "color", "$value": "#ff9728",                 "$description": "预警(临时,待终稿)" },
    "safe":            { "$type": "color", "$value": "#00cc92",                 "$description": "安全(临时,待终稿)" },
    "info":            { "$type": "color", "$value": "#2a99fe",                 "$description": "中性提醒(临时,待终稿)" },

    "chart-blue":      { "$type": "color", "$value": "#0cb6ff" },
    "chart-purple":    { "$type": "color", "$value": "#5a74ff" },
    "chart-yellow":    { "$type": "color", "$value": "#ffa61f" },
    "chart-green":     { "$type": "color", "$value": "#35c15c" },
    "chart-pink":      { "$type": "color", "$value": "#ec54b8" },
    "chart-red":       { "$type": "color", "$value": "#de3150" },
    "chart-orange":    { "$type": "color", "$value": "#ff7128" },
    "chart-grey":      { "$type": "color", "$value": "#c1d0e6" },
    "chart-bg":        { "$type": "color", "$value": "#2c3039" },

    "chatbox":         { "$type": "color", "$value": "#00a9a9" },
    "chatbox-at":      { "$type": "color", "$value": "#00f0c4" },
    "avatar-fill":     { "$type": "color", "$value": "rgba(204, 204, 204, 0.6)" },
    "mask":            { "$type": "color", "$value": "rgba(10, 14, 25, 0.6)" },

    "hairline":        { "$type": "color", "$value": "{color.stroke}",          "$description": "细分隔(stroke 别名)" },
    "hairline-strong": { "$type": "color", "$value": "{color.line}",            "$description": "强分隔(line 别名)" },
    "border":          { "$type": "color", "$value": "{color.stroke}",          "$description": "默认边界" },
    "divider":         { "$type": "color", "$value": "{color.line}",            "$description": "明显分隔" }
  },

  "fs": {
    "$description": "字号 12 档,基于 Bloomberg 密集 UI 归纳",
    "3xs":     { "$type": "dimension", "$value": "0.5rem",    "$description": "8px — K 线日期" },
    "2xs":     { "$type": "dimension", "$value": "0.5625rem", "$description": "9px — 坐标轴" },
    "xs":      { "$type": "dimension", "$value": "0.625rem",  "$description": "10px — caps label" },
    "sm":      { "$type": "dimension", "$value": "0.6875rem", "$description": "11px — Bloomberg 主力" },
    "base":    { "$type": "dimension", "$value": "0.75rem",   "$description": "12px — 数据值、正文" },
    "md":      { "$type": "dimension", "$value": "0.8125rem", "$description": "13px — 段头" },
    "lg":      { "$type": "dimension", "$value": "0.875rem",  "$description": "14px — 强调标题" },
    "xl":      { "$type": "dimension", "$value": "1.125rem",  "$description": "18px — 汇总值" },
    "2xl":     { "$type": "dimension", "$value": "1.5rem",    "$description": "24px — 大字小" },
    "3xl":     { "$type": "dimension", "$value": "2.25rem",   "$description": "36px — 大字中" },
    "4xl":     { "$type": "dimension", "$value": "3rem",      "$description": "48px — 大字大" },
    "6xl":     { "$type": "dimension", "$value": "3.75rem",   "$description": "60px — 大数字(报价主角,全局唯一用例)" }
  },

  "fw": {
    "$description": "字重 4 档",
    "normal":   { "$type": "fontWeight", "$value": 400 },
    "medium":   { "$type": "fontWeight", "$value": 500 },
    "semibold": { "$type": "fontWeight", "$value": 600 },
    "bold":     { "$type": "fontWeight", "$value": 700 }
  },

  "lh": {
    "$description": "行高 8 档",
    "none":           { "$type": "number", "$value": 1,    "$description": "大字 / 单行" },
    "tight":          { "$type": "number", "$value": 1.2,  "$description": "标题" },
    "dense":          { "$type": "number", "$value": 1.3,  "$description": "Bloomberg 密集数据行" },
    "snug":           { "$type": "number", "$value": 1.4,  "$description": "紧凑正文" },
    "normal":         { "$type": "number", "$value": 1.5,  "$description": "默认正文" },
    "relaxed-tight":  { "$type": "number", "$value": 1.55, "$description": "EarningsForecast spread bar 文字" },
    "relaxed-snug":   { "$type": "number", "$value": 1.6,  "$description": "NewsCardBig summary / EventTracker 描述" },
    "relaxed":        { "$type": "number", "$value": 1.65, "$description": "长段描述 / AI summary" }
  },

  "ls": {
    "$description": "字距 7 档",
    "tightest":    { "$type": "dimension", "$value": "-0.04em", "$description": "大字 60px+" },
    "tight":       { "$type": "dimension", "$value": "-0.02em", "$description": "数字(mono)" },
    "snug":        { "$type": "dimension", "$value": "-0.01em", "$description": "默认 sans" },
    "normal":      { "$type": "dimension", "$value": "0" },
    "wide":        { "$type": "dimension", "$value": "0.04em",  "$description": "ticker / 短小 caps" },
    "caps-narrow": { "$type": "dimension", "$value": "0.06em",  "$description": "中等 ALL CAPS(分组标题)" },
    "wider":       { "$type": "dimension", "$value": "0.1em",   "$description": "caps label(数据维度)" }
  },

  "sp": {
    "$description": "间距 14 基础 + 6 语义",
    "0":   { "$type": "dimension", "$value": "0" },
    "px":  { "$type": "dimension", "$value": "1px" },
    "0-5": { "$type": "dimension", "$value": "0.125rem",  "$description": "2px" },
    "1":   { "$type": "dimension", "$value": "0.25rem",   "$description": "4px" },
    "1-5": { "$type": "dimension", "$value": "0.375rem",  "$description": "6px" },
    "2":   { "$type": "dimension", "$value": "0.5rem",    "$description": "8px" },
    "3":   { "$type": "dimension", "$value": "0.75rem",   "$description": "12px" },
    "4":   { "$type": "dimension", "$value": "1rem",      "$description": "16px" },
    "5":   { "$type": "dimension", "$value": "1.25rem",   "$description": "20px" },
    "6":   { "$type": "dimension", "$value": "1.5rem",    "$description": "24px" },
    "8":   { "$type": "dimension", "$value": "2rem",      "$description": "32px" },
    "10":  { "$type": "dimension", "$value": "2.5rem",    "$description": "40px" },
    "12":  { "$type": "dimension", "$value": "3rem",      "$description": "48px" },
    "16":  { "$type": "dimension", "$value": "4rem",      "$description": "64px" },
    "card-x":  { "$type": "dimension", "$value": "{sp.4}",   "$description": "卡片水平 padding" },
    "card-y":  { "$type": "dimension", "$value": "{sp.3}",   "$description": "卡片垂直 padding" },
    "section": { "$type": "dimension", "$value": "{sp.4}",   "$description": "section 间距" },
    "row":     { "$type": "dimension", "$value": "{sp.1-5}", "$description": "table row 间距" },
    "inline":  { "$type": "dimension", "$value": "{sp.2}",   "$description": "inline 元素间距" },
    "stack":   { "$type": "dimension", "$value": "{sp.3}",   "$description": "垂直堆叠间距" }
  },

  "r": {
    "$description": "圆角 8 档(Bloomberg 主用 sm)",
    "none": { "$type": "dimension", "$value": "0" },
    "xs":   { "$type": "dimension", "$value": "0.125rem", "$description": "2px" },
    "sm":   { "$type": "dimension", "$value": "0.25rem",  "$description": "4px — Bloomberg 主力" },
    "md":   { "$type": "dimension", "$value": "0.375rem", "$description": "6px" },
    "lg":   { "$type": "dimension", "$value": "0.5rem",   "$description": "8px" },
    "xl":   { "$type": "dimension", "$value": "0.75rem",  "$description": "12px" },
    "2xl":  { "$type": "dimension", "$value": "1rem",     "$description": "16px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },

  "bw": {
    "$description": "边框宽度 5 档",
    "0": { "$type": "dimension", "$value": "0" },
    "1": { "$type": "dimension", "$value": "1px", "$description": "hairline 默认" },
    "2": { "$type": "dimension", "$value": "2px", "$description": "tab active / focus ring" },
    "3": { "$type": "dimension", "$value": "3px", "$description": "中等强调(选中卡片左侧)" },
    "4": { "$type": "dimension", "$value": "4px", "$description": "strong section divider" }
  },

  "sh": {
    "$description": "阴影 9 档(含 elevation + 状态 + glow)",
    "none":          { "$type": "shadow", "$value": "none" },
    "flat":          { "$type": "shadow", "$value": "0 1px 2px rgba(0, 0, 0, 0.3)",                                "$description": "hover 微浮起" },
    "raised":        { "$type": "shadow", "$value": "0 2px 8px rgba(0, 0, 0, 0.35), 0 4px 16px rgba(0, 0, 0, 0.2)", "$description": "卡片浮起" },
    "popover":       { "$type": "shadow", "$value": "0 4px 16px rgba(0, 0, 0, 0.4), 0 12px 32px rgba(0, 0, 0, 0.3)", "$description": "dropdown / tooltip" },
    "modal":         { "$type": "shadow", "$value": "0 8px 32px rgba(0, 0, 0, 0.5), 0 24px 64px rgba(0, 0, 0, 0.4)", "$description": "modal / drawer" },
    "focus-ring":    { "$type": "shadow", "$value": "0 0 0 2px rgba(0, 240, 196, 0.4)",                            "$description": "focus 圈(brand 色)" },
    "inset-pressed": { "$type": "shadow", "$value": "inset 0 1px 2px rgba(0, 0, 0, 0.3)",                          "$description": "按下态内阴影" },
    "glow-up":       { "$type": "shadow", "$value": "0 0 8px rgba(0, 173, 162, 0.4)",                              "$description": "涨色辉光" },
    "glow-down":     { "$type": "shadow", "$value": "0 0 8px rgba(255, 58, 117, 0.4)",                             "$description": "跌色辉光" }
  },

  "op": {
    "$description": "透明度 7 档",
    "transparent": { "$type": "number", "$value": 0,    "$description": "完全透明" },
    "hover-bg":    { "$type": "number", "$value": 0.05, "$description": "hover 背景极淡" },
    "overlay-bg":  { "$type": "number", "$value": 0.1,  "$description": "背景蒙层 / 微强调" },
    "disabled":    { "$type": "number", "$value": 0.4,  "$description": "禁用态" },
    "muted":       { "$type": "number", "$value": 0.6,  "$description": "弱化" },
    "emphasis":    { "$type": "number", "$value": 0.85, "$description": "强调" },
    "full":        { "$type": "number", "$value": 1,    "$description": "默认" }
  },

  "dur": {
    "$description": "动效时长 7 档",
    "instant": { "$type": "duration", "$value": "50ms",  "$description": "立即响应(click feedback)" },
    "fast":    { "$type": "duration", "$value": "80ms",  "$description": "hover / focus / tab 切换" },
    "base":    { "$type": "duration", "$value": "150ms", "$description": "默认状态变化" },
    "modal":   { "$type": "duration", "$value": "200ms", "$description": "modal / drawer 出现消失" },
    "slow":    { "$type": "duration", "$value": "240ms", "$description": "展开折叠" },
    "flash":   { "$type": "duration", "$value": "300ms", "$description": "价格闪烁(用 linear)" },
    "slower":  { "$type": "duration", "$value": "400ms", "$description": "重过渡 / 页面切换" }
  },

  "ease": {
    "$description": "缓动 7 档",
    "linear":     { "$type": "cubicBezier", "$value": "linear",                                  "$description": "线性 — 价格闪烁 / progress" },
    "out":        { "$type": "cubicBezier", "$value": "cubic-bezier(0.16, 1, 0.3, 1)",            "$description": "默认 — 弹性出(Linear 风)" },
    "in-out":     { "$type": "cubicBezier", "$value": "cubic-bezier(0.4, 0, 0.2, 1)",             "$description": "平滑双向(Material standard)" },
    "snap":       { "$type": "cubicBezier", "$value": "cubic-bezier(0.22, 1, 0.36, 1)",           "$description": "snappy out(Apple 风,无过冲)" },
    "decelerate": { "$type": "cubicBezier", "$value": "cubic-bezier(0, 0, 0.2, 1)",               "$description": "弹入(modal 进入)" },
    "accelerate": { "$type": "cubicBezier", "$value": "cubic-bezier(0.4, 0, 1, 1)",               "$description": "弹出(modal 退出)" },
    "bounce":     { "$type": "cubicBezier", "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)",        "$description": "弹跳(慎用)" }
  },

  "z": {
    "$description": "Z-Index 10 档",
    "base":     { "$type": "number", "$value": 0,    "$description": "默认层" },
    "sticky":   { "$type": "number", "$value": 10,   "$description": "sticky 顶/底栏" },
    "dropdown": { "$type": "number", "$value": 25,   "$description": "下拉菜单(sticky 上,overlay 下)" },
    "overlay":  { "$type": "number", "$value": 30,   "$description": "浮层 / drawer 背景" },
    "fab":      { "$type": "number", "$value": 35,   "$description": "浮动操作按钮" },
    "modal":    { "$type": "number", "$value": 40,   "$description": "modal 内容层" },
    "popover":  { "$type": "number", "$value": 60,   "$description": "popover / hover card" },
    "tooltip":  { "$type": "number", "$value": 70,   "$description": "tooltip 顶层" },
    "toast":    { "$type": "number", "$value": 80,   "$description": "toast / 通知" },
    "debug":    { "$type": "number", "$value": 9999, "$description": "调试 overlay" }
  },

  "font": {
    "$description": "字体族",
    "sans": { "$type": "fontFamily", "$value": "\"Inter\", -apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Noto Sans SC\", system-ui, sans-serif" },
    "num":  { "$type": "fontFamily", "$value": "\"JetBrains Mono\", \"SF Mono\", Menlo, Consolas, monospace" }
  },

  "component": {
    "$description": "组件尺寸规范(button / input / card / table / topbar / footer / tab)",
    "button-height-sm":     { "$type": "dimension", "$value": "24px", "$description": "小按钮" },
    "button-height-md":     { "$type": "dimension", "$value": "32px", "$description": "默认按钮" },
    "button-height-lg":     { "$type": "dimension", "$value": "40px", "$description": "primary CTA" },
    "button-px-sm":         { "$type": "dimension", "$value": "8px",  "$description": "小按钮水平 padding" },
    "button-px-md":         { "$type": "dimension", "$value": "12px", "$description": "默认按钮水平 padding" },
    "button-px-lg":         { "$type": "dimension", "$value": "16px", "$description": "CTA 水平 padding" },

    "input-height":         { "$type": "dimension", "$value": "32px", "$description": "输入框高度" },
    "input-px":             { "$type": "dimension", "$value": "12px", "$description": "输入框水平 padding" },

    "card-px":              { "$type": "dimension", "$value": "{sp.4}", "$description": "卡片水平 padding(同 sp.card-x)" },
    "card-py":              { "$type": "dimension", "$value": "{sp.3}", "$description": "卡片垂直 padding(同 sp.card-y)" },

    "table-row-height":       { "$type": "dimension", "$value": "32px", "$description": "默认 table row" },
    "table-row-height-dense": { "$type": "dimension", "$value": "24px", "$description": "Bloomberg 密集 row" },
    "table-header-height":    { "$type": "dimension", "$value": "28px", "$description": "table header" },

    "topbar-height":        { "$type": "dimension", "$value": "32px", "$description": "顶部命令栏" },
    "footer-bar-height":    { "$type": "dimension", "$value": "32px", "$description": "底部 function bar" },
    "tab-height":           { "$type": "dimension", "$value": "40px", "$description": "Tab Bar 高度" },

    "checkbox-size":        { "$type": "dimension", "$value": "16px" },
    "radio-size":           { "$type": "dimension", "$value": "16px" },
    "switch-width":         { "$type": "dimension", "$value": "32px" },
    "switch-height":        { "$type": "dimension", "$value": "18px" },

    "avatar-sm":            { "$type": "dimension", "$value": "20px" },
    "avatar-md":            { "$type": "dimension", "$value": "32px" },
    "avatar-lg":            { "$type": "dimension", "$value": "48px" }
  },

  "breakpoint": {
    "$description": "响应式断点(Tailwind 默认对齐)",
    "sm":  { "$type": "dimension", "$value": "640px",  "$description": "手机横屏 / 小平板" },
    "md":  { "$type": "dimension", "$value": "768px",  "$description": "平板" },
    "lg":  { "$type": "dimension", "$value": "1024px", "$description": "笔记本 / 小桌面" },
    "xl":  { "$type": "dimension", "$value": "1280px", "$description": "标准桌面" },
    "2xl": { "$type": "dimension", "$value": "1536px", "$description": "大桌面 / 4K" }
  },

  "container": {
    "$description": "容器最大宽度",
    "max":        { "$type": "dimension", "$value": "1280px", "$description": "标准容器(stock-detail-v2 主区)" },
    "max-wide":   { "$type": "dimension", "$value": "1480px", "$description": "宽容器(ComponentGallery)" },
    "max-narrow": { "$type": "dimension", "$value": "920px",  "$description": "窄容器(阅读体)" }
  },

  "icon": {
    "$description": "图标尺寸 7 档",
    "2xs": { "$type": "dimension", "$value": "10px", "$description": "inline 微图标(箭头/dot)" },
    "xs":  { "$type": "dimension", "$value": "12px", "$description": "button inline icon" },
    "sm":  { "$type": "dimension", "$value": "14px", "$description": "Bloomberg 主力" },
    "md":  { "$type": "dimension", "$value": "16px", "$description": "默认 menu icon" },
    "lg":  { "$type": "dimension", "$value": "20px", "$description": "navigation icon" },
    "xl":  { "$type": "dimension", "$value": "24px", "$description": "页面级 icon" },
    "2xl": { "$type": "dimension", "$value": "32px", "$description": "empty-state icon" }
  }
}
